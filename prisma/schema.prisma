generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Course {
  id      Int       @id @default(autoincrement())
  name    String
  student Student[]
}

model Student {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])
}